{
  "name": "milume-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env MILUME_BUILD_WIDGET=landmarks vite build",
    "dev:landmarks": "vite",
    "dev:fixture": "uv run --directory .. python frontend/dev/export-fixture.py",
    "watch": "cross-env MILUME_BUILD_WIDGET=landmarks vite build --watch",
    "watch:landmarks": "cross-env MILUME_BUILD_WIDGET=landmarks vite build --watch",
    "dev:landmarks-volume": "cross-env DEV_WIDGET=landmarks-volume vite",
    "dev:landmarks-volume-xsmall": "cross-env DEV_WIDGET=landmarks-volume MILUME_VOLUME_PROFILE=xsmall vite",
    "dev:fixture:volume": "uv run --directory .. python frontend/dev/export-landmarks-volume-fixture.py",
    "dev:fixture:volume-xsmall": "uv run --extra demo --directory .. python frontend/dev/export-landmarks-volume-fixture.py --profile xsmall",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run test:e2e:core && npm run test:e2e:landmarks",
    "test:e2e:core": "playwright test e2e/core",
    "test:e2e:landmarks": "cross-env E2E_HARNESS=landmarks-volume playwright test e2e/landmarks/landmarks-volume.spec.ts && playwright test e2e/landmarks",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:mac": "cross-env PLAYWRIGHT_CHANNEL=chrome playwright test",
    "test:e2e:update": "playwright test --update-snapshots=all",
    "test:e2e:update:core": "playwright test e2e/core --update-snapshots=all",
    "test:e2e:update:landmarks": "playwright test e2e/landmarks --update-snapshots=all",
    "check:chrome": "node scripts/check-chrome.mjs",
    "check:pr-policy": "node scripts/check-pr-policy.mjs",
    "check:widget-issue": "node scripts/check-widget-issue.mjs",
    "test:agent-policy": "node --test scripts/check-agent-policy.test.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "overrides": {
    "@deck.gl/core": "9.2.11",
    "@deck.gl/extensions": "9.2.11",
    "@deck.gl/geo-layers": "9.2.11",
    "@deck.gl/layers": "9.2.11",
    "@deck.gl/mesh-layers": "9.2.11",
    "@deck.gl/react": "9.2.11",
    "@deck.gl/widgets": "9.2.11",
    "@luma.gl/constants": "9.2.6",
    "@luma.gl/core": "9.2.6",
    "@luma.gl/engine": "9.2.6",
    "@luma.gl/gltf": "9.2.6",
    "@luma.gl/shadertools": "9.2.6",
    "@luma.gl/webgl": "9.2.6"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@deck.gl/core": "9.2.11",
    "@deck.gl/extensions": "9.2.11",
    "@deck.gl/layers": "9.2.11",
    "@deck.gl/widgets": "9.2.11",
    "@hms-dbmi/viv": "^0.22.1",
    "@loaders.gl/core": "4.3.4",
    "@luma.gl/constants": "9.2.6",
    "@luma.gl/core": "9.2.6",
    "@luma.gl/engine": "9.2.6",
    "@luma.gl/shadertools": "9.2.6",
    "@luma.gl/webgl": "9.2.6",
    "@math.gl/core": "^4.1.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@thi.ng/geom-accel": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cube-motion": "^0.1.0",
    "lucide-react": "^1.37.0",
    "polygon-clipping": "^0.15.7",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zarrita": "^0.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
